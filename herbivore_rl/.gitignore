# 재생성 가능한 산출물. 저장소 .gitattributes가 *.mp4 를 LFS로 보내는데,
# 리플레이는 한 편에 ~10MB라 커밋할 이유가 없다. 스크립트로 언제든 다시 만든다.
results/*.mp4
results/*.gif
results/_*

# 학습 산출물 (Phase 3 이후)
runs/
*.zip
optuna*.db
# ckpt/ 는 디렉터리째 무시하면 하위 예외가 안 먹는다. 내용물을 무시한다.
ckpt/*
# 측정 기준선 json만 남긴다 — §6.6 판정 근거이고 몇 백 바이트다
!ckpt/warmstart_baseline.json

__pycache__/
*.py[cod]
.pytest_cache/
# V2 산출물 — 영상·학습 로그는 재생성 가능하다. 진단 결과(JSON·MD)는 남긴다.
results/v2/*.mp4
results/v2/*.gif
results/v2/*.log
results/v3/**/*.mp4
